{
  "name": "agentkit",
  "version": "0.1.0",
  "description": "Configurable multi-agent orchestrator framework",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentkit": "dist/cli/index.js",
    "rezontree-manage": "dist/manage.js",
    "rt": "bin/rt.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "manage": "tsx src/manage.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preflight": "tsx src/bootstrap/preflight.ts",
    "testnet:bootstrap": "tsx src/bootstrap/testnet.ts",
    "rt": "tsx bin/rt.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.71",
    "@anthropic-ai/sdk": "^0.39.0",
    "@libsql/client": "^0.17.3",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "chalk": "^5.4.0",
    "commander": "^13.1.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.3.1",
    "viem": "^2.48.1",
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}