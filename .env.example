# ─── Model providers (required: at least one) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-v1-...

# ─── Standard MCP integrations (optional) ───────────────────────────────────
GITHUB_TOKEN=ghp_...
PROTOCOL_API_URL=http://localhost:8080
REMOTE_API_KEY=...

# ─── Testnet / wallet-atomic agent config (loop 0061+) ──────────────────────
# Single BIP-39 mnemonic seeds all agent wallets via HD derivation
# (m/44'/60'/0'/0/N where N is the YAML agent index). Each agent gets
# its own testnet address; operator funds each with Sepolia ETH (for gas)
# + USDC (for L2 participation).
#
# DO NOT commit real mnemonics. This is a testnet-only workflow;
# production operators should use a hardware wallet or KMS.
RT_AGENT_MNEMONIC="test test test test test test test test test test test junk"

# Backend URL the agent MCP servers talk to. Local dev: localhost:8080.
# Staging: the deployed backend.
RT_AGENT_BACKEND_URL=http://localhost:8080

# Testnet RPC (defaults to public Base Sepolia RPC; override if rate-limited)
# RT_AGENT_RPC_URL=https://sepolia.base.org

# ─── Error reporting (loop 0064 — monitor + fix loop) ───────────────────────
# File sink is always-on; webhook is opt-in. Slack / Discord / custom all
# accept POST with a JSON body. Leave unset to disable webhook sink.
# RT_AGENT_ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...
