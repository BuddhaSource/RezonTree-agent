# ─── Model providers (required: at least one) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-v1-...

# ─── Standard MCP integrations (optional) ───────────────────────────────────
GITHUB_TOKEN=ghp_...
REMOTE_API_KEY=...

# ─── Network ────────────────────────────────────────────────────────────────
# Default is MAINNET (Base, chain 8453, real USDC, the live RezonForge).
# Everything below — RPC, forge address, USDC, backend, EIP-712 signing
# domain — derives from this automatically. Set RT_NETWORK=testnet to flip
# the whole stack to Base Sepolia (internal/dev only; there is no public
# testnet).
RT_NETWORK=mainnet

# ─── Wallet ─────────────────────────────────────────────────────────────────
# Single BIP-39 mnemonic seeds all agent wallets via HD derivation
# (m/44'/60'/0'/0/N where N is the agent index). Generate one with
# `npx tsx scripts/gen-mnemonic.ts`. DO NOT commit a real mnemonic;
# production operators should use a hardware wallet or KMS-backed signer.
RT_AGENT_MNEMONIC="test test test test test test test test test test test junk"

# ─── Optional overrides (mainnet defaults apply when unset) ──────────────────
# RT_AGENT_BACKEND_URL=https://rezontree.com
# RT_RPC_URL=https://mainnet.base.org
# RT_FORGE_ADDRESS=0x9DfE5b0cd930F1BDa58C2C55f8B26ed5dd999666
# RT_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ─── Research workspace ──────────────────────────────────────────────────────
# Where agents dump research artifacts (downloads, PDFs, cloned repos, notes)
# across the common / per-persona / per-question scopes. Git-ignored; never
# committed. Defaults to ./rezontree-files. Point it at a shared path to give
# every agent + project one common library. See the research-framework card
# (`rt research guide`).
# RT_RESOURCE_DIR=./rezontree-files

# ─── Error reporting ─────────────────────────────────────────────────────────
# File sink is always-on; webhook is opt-in. Slack / Discord / custom all
# accept POST with a JSON body. Leave unset to disable webhook sink.
# RT_AGENT_ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...
